<?xml version="1.0" encoding="utf-8"?>
<mujoco model="system_benchmark_loaded_spoon">
  <!-- World and neutral CAD assembly frames agree: X follows the handle,
       Y points across the fork, and Z completes the right-handed frame.
       Source STEP coordinates are millimetres; mesh vertices are scaled to m. -->
  <compiler angle="radian" meshdir="cad_spoon/meshes"/>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast" cone="elliptic" iterations="80" tolerance="1e-10"/>
  <default>
    <geom contype="0" conaffinity="0" group="1"/>
  </default>

  <asset>
    <mesh name="spoon_mount84" file="part_000_spoon_mount84.stl" scale="0.001 0.001 0.001"/>
    <mesh name="spoon_mount92" file="part_001_spoon_mount92.stl" scale="0.001 0.001 0.001"/>
    <mesh name="spoon_adapter_upper" file="part_002_s_adapter_spoon_upper.stl" scale="0.001 0.001 0.001"/>
    <mesh name="spoon_adapter_lower" file="part_003_s_adapter_spoon_lower.stl" scale="0.001 0.001 0.001"/>
    <mesh name="spoon_head" file="part_004_spoon_head.stl" scale="0.001 0.001 0.001"/>
    <mesh name="handle_upper" file="part_005_h_upper.stl" scale="0.001 0.001 0.001"/>
    <mesh name="handle_lower" file="part_006_h_lower.stl" scale="0.001 0.001 0.001"/>
    <mesh name="roll_cover_upper" file="part_007_s_symmetric_spoon_upper.stl" scale="0.001 0.001 0.001"/>
    <mesh name="roll_cover_lower" file="part_008_s_symmetric_spoon_lower.stl" scale="0.001 0.001 0.001"/>
    <mesh name="fork" file="part_009_m_fork.stl" scale="0.001 0.001 0.001"/>
    <mesh name="counterweight" file="part_010_m_counterweight.stl" scale="0.001 0.001 0.001"/>
    <mesh name="pitch_cover_negative" file="part_011_v2_pitch_cover__1.stl" scale="0.001 0.001 0.001"/>
    <mesh name="passive_shaft" file="part_012_m_passive_shaft.stl" scale="0.001 0.001 0.001"/>
    <mesh name="pitch_cover_positive" file="part_013_v2_pitch_cover_1.stl" scale="0.001 0.001 0.001"/>
    <mesh name="quick_release" file="part_014_m_quick_release.stl" scale="0.001 0.001 0.001"/>
    <mesh name="spoon_holder" file="part_015_tool_spoon.stl" scale="0.001 0.001 0.001"/>
  </asset>

