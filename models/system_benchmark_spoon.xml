        <geom name="bowl_floor_proxy" type="box" pos="0.064 0 -0.0015" size="0.024 0.020 0.0015" contype="1" conaffinity="2" group="3" rgba="0.95 0.72 0.25 0.32" friction="0.8 0.01 0.001" condim="3" solref="0.003 1"/>
        <geom name="bowl_wall_xn" type="box" pos="0.040 0 0.0035" size="0.0015 0.020 0.005" contype="1" conaffinity="2" group="3" rgba="0.95 0.72 0.25 0.32" friction="0.8 0.01 0.001" condim="3"/>
        <geom name="bowl_wall_xp" type="box" pos="0.088 0 0.0035" size="0.0015 0.020 0.005" contype="1" conaffinity="2" group="3" rgba="0.95 0.72 0.25 0.32" friction="0.8 0.01 0.001" condim="3"/>
        <geom name="bowl_wall_yn" type="box" pos="0.064 -0.020 0.0035" size="0.024 0.0015 0.005" contype="1" conaffinity="2" group="3" rgba="0.95 0.72 0.25 0.32" friction="0.8 0.01 0.001" condim="3"/>
        <geom name="bowl_wall_yp" type="box" pos="0.064 0.020 0.0035" size="0.024 0.0015 0.005" contype="1" conaffinity="2" group="3" rgba="0.95 0.72 0.25 0.32" friction="0.8 0.01 0.001" condim="3"/>
        </body>
      </body>
