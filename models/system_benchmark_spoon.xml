      <geom name="cup_bottom" type="box" pos="0 0 0.105" size="0.060 0.060 0.004" contype="4" conaffinity="2" group="3" rgba="0.20 0.45 0.80 0.38" friction="0.8 0.01 0.001"/>
      <geom name="cup_wall_xn" type="box" pos="-0.063 0 0.155" size="0.003 0.063 0.05" contype="4" conaffinity="2" group="3" rgba="0.20 0.45 0.80 0.38"/>
      <geom name="cup_wall_xp" type="box" pos="0.063 0 0.155" size="0.003 0.063 0.05" contype="4" conaffinity="2" group="3" rgba="0.20 0.45 0.80 0.38"/>
      <geom name="cup_wall_yn" type="box" pos="0 -0.063 0.155" size="0.060 0.003 0.05" contype="4" conaffinity="2" group="3" rgba="0.20 0.45 0.80 0.38"/>
      <geom name="cup_wall_yp" type="box" pos="0 0.063 0.155" size="0.060 0.003 0.05" contype="4" conaffinity="2" group="3" rgba="0.20 0.45 0.80 0.38"/>
    </body>
    <!-- Fixed world reference used by the weighted tip-position experiment. -->
    <site name="neutral_tip_target" pos="0.154 0 0" size="0.004" rgba="0.75 0 0.8 0.8"/>
    <!-- Set data.mocap_pos[0] and data.mocap_quat[0] to drive the handle. -->
    <body name="handle" mocap="true">
      <geom name="handle_upper_visual" type="mesh" mesh="handle_upper"/>
      <geom name="handle_lower_visual" type="mesh" mesh="handle_lower"/>
      <site name="handle_frame" pos="0 0 0" size="0.002" rgba="0.1 0.3 1 1"/>

      <!-- Roll axis from rm_shaft CAD cylinder: (6.02, 0, 0) mm, along X. -->
      <body name="roll_frame" pos="0.00602 0 0">
        <joint name="roll" type="hinge" axis="1 0 0" range="-0.785398 0.785398"
               damping="0.002" armature="0.00001" solreflimit="0.002 1"/>
        <!-- Uniform-density CAD inertia rescaled to assumed 0.11 kg. -->
        <inertial pos="0.04427256 -0.00383813 0.00015151" mass="0.11"
                  fullinertia="0.000376574572 0.0000691934918 0.000430417759 0.0000095097463 -0.000000504899006 -0.0000000639433921"/>
        <geom name="roll_cover_upper_visual" type="mesh" mesh="roll_cover_upper" pos="-0.00602 0 0"/>
        <geom name="roll_cover_lower_visual" type="mesh" mesh="roll_cover_lower" pos="-0.00602 0 0"/>
        <geom name="fork_visual" type="mesh" mesh="fork" pos="-0.00602 0 0"/>
        <geom name="counterweight_visual" type="mesh" mesh="counterweight" pos="-0.00602 0 0"/>
        <geom name="pitch_cover_negative_visual" type="mesh" mesh="pitch_cover_negative" pos="-0.00602 0 0"/>
        <geom name="pitch_cover_positive_visual" type="mesh" mesh="pitch_cover_positive" pos="-0.00602 0 0"/>
        <site name="roll_axis_origin" pos="0 0 0" size="0.002" rgba="1 0.3 0.2 1"/>

        <!-- Pitch axis from pm_shaft CAD cylinder: (73, 46, 0) mm, along Y.
             The same line passes through (73, 0, 0) mm. -->
        <body name="pitch_frame" pos="0.06698 0 0">
          <joint name="pitch" type="hinge" axis="0 1 0" range="-0.785398 0.785398"
                 damping="0.001" armature="0.000005" solreflimit="0.002 1"/>
          <!-- Uniform-density CAD inertia rescaled to assumed 0.06 kg. -->
          <inertial pos="0.01233328 0.00199499 0.00078597" mass="0.06"
                    fullinertia="0.0000568080734 0.0000219952758 0.0000739035275 0.00000173508769 0.00000143670662 0.000000534297475"/>
          <geom name="passive_shaft_visual" type="mesh" mesh="passive_shaft" pos="-0.073 0 0"/>
          <geom name="quick_release_visual" type="mesh" mesh="quick_release" pos="-0.073 0 0"/>
          <geom name="spoon_holder_visual" type="mesh" mesh="spoon_holder" pos="-0.073 0 0"/>
          <geom name="spoon_adapter_upper_visual" type="mesh" mesh="spoon_adapter_upper" pos="-0.073 0 0"/>
          <geom name="spoon_adapter_lower_visual" type="mesh" mesh="spoon_adapter_lower" pos="-0.073 0 0"/>
          <geom name="spoon_mount84_visual" type="mesh" mesh="spoon_mount84" pos="-0.073 0 0"/>
          <geom name="spoon_mount92_visual" type="mesh" mesh="spoon_mount92" pos="-0.073 0 0"/>
          <geom name="spoon_head_visual" type="mesh" mesh="spoon_head" pos="-0.073 0 0"/>
          <site name="tool_frame" pos="0.03 0 0" size="0.002" rgba="0 0.8 0.2 1"/>
          <site name="spoon_tip" pos="0.081 0 0" size="0.003" rgba="1 0.2 0.2 1"/>
